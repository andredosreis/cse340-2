<div class="mx-auto bg-white shadow md:my-6 border-8 border-black max-w-[980px]">
  <!-- Top bar (dark) -->
  <header class="flex items-center justify-between px-4 py-2 bg-slate-800 text-white">
    <!-- Brand -->
    <div class="flex items-center gap-2">
      <span class="text-[18px] md:text-[20px] font-semibold tracking-tight">CSE Motors</span>
    </div>

    <%# ========================================== %>
    <%# DYNAMIC ACCOUNT SECTION %>
    <%# ========================================== %>
    <%# accountData vem de res.locals (definido no middleware) %>
    <%# Se accountData existe = usuário está logado %>
    <%# Se accountData é null = usuário não está logado %>

    <!-- Account Section -->
    <div class="flex items-center gap-3">
      <% if (typeof accountData !== 'undefined' && accountData) { %>
        <%# USUÁRIO ESTÁ LOGADO %>
        <%# Mostrar: "Welcome, Nome | Logout" %>

        <span class="text-[11px] md:text-[12px] opacity-80">
          Welcome, <strong class="opacity-100"><%= accountData.account_firstname %></strong>!
        </span>

        <a
          href="/account/"
          class="text-[11px] md:text-[12px] opacity-90 hover:opacity-100 underline-offset-2 hover:underline"
          title="Manage your account"
        >
          My Account
        </a>

        <span class="text-[11px] opacity-50">|</span>

        <a
          href="/account/logout"
          class="text-[11px] md:text-[12px] opacity-90 hover:opacity-100 underline-offset-2 hover:underline text-red-300"
          title="Sign out"
        >
          Logout
        </a>

      <% } else { %>
        <%# USUÁRIO NÃO ESTÁ LOGADO %>
        <%# Mostrar: "My Account" (link para login) %>

        <a
          href="/account/login"
          class="text-[12px] md:text-[12px] opacity-90 hover:opacity-100 underline-offset-2 hover:underline"
          title="Sign in to your account"
        >
          My Account
        </a>

      <% } %>
    </div>
  </header>

  <!-- Thin separator like the mockup -->
  <div class="h-[6px] bg-cyan-400"></div>

  <!-- Nav - Dynamic navigation from database -->
  <nav class="flex flex-wrap items-center gap-2 px-4 py-2 text-[13px] border-b">
    <%- nav %>
  </nav>

  <!-- Content shell -->
  <main class="p-3 md:p-4 space-y-6 md:space-y-8">