<%# ============================================== %>
<%# UPDATE ACCOUNT VIEW %>
<%# ============================================== %>
<%# Formulário para atualizar dados da conta %>
<%# URL: /account/update (protegida - requer login) %>
<%# ============================================== %>

<%# Flash message %>
<% if (flash && flash.length > 0) { %>
  <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded">
    <p class="font-medium"><%= flash %></p>
  </div>
<% } %>

<%# Erros de validação %>
<% if (errors && errors.array) { %>
  <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
    <p class="font-bold mb-2">Please fix the following errors:</p>
    <ul class="list-disc list-inside">
      <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="max-w-xl mx-auto mt-10">
  <%# Cabeçalho %>
  <div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white p-6 rounded-t-lg shadow-lg">
    <h1 class="text-2xl font-bold">Update Account Information</h1>
    <p class="mt-1 text-blue-100">Update your personal details below</p>
  </div>

  <%# Formulário %>
  <form
    action="/account/update"
    method="POST"
    class="bg-white p-6 shadow-lg rounded-b-lg space-y-6"
    id="updateAccountForm"
  >
    <%# Hidden field para account_id %>
    <input type="hidden" name="account_id" value="<%= account_id %>">

    <%# Campo: First Name %>
    <div>
      <label for="account_firstname" class="block text-sm font-medium text-gray-700 mb-1">
        First Name <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="account_firstname"
        name="account_firstname"
        value="<%= account_firstname %>"
        required
        minlength="1"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
        placeholder="Enter your first name"
      >
    </div>

    <%# Campo: Last Name %>
    <div>
      <label for="account_lastname" class="block text-sm font-medium text-gray-700 mb-1">
        Last Name <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="account_lastname"
        name="account_lastname"
        value="<%= account_lastname %>"
        required
        minlength="1"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
        placeholder="Enter your last name"
      >
    </div>

    <%# Campo: Email %>
    <div>
      <label for="account_email" class="block text-sm font-medium text-gray-700 mb-1">
        Email Address <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="account_email"
        name="account_email"
        value="<%= account_email %>"
        required
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
        placeholder="your@email.com"
      >
    </div>

    <%# Botões %>
    <div class="flex gap-4 pt-4">
      <button
        type="submit"
        class="flex-1 bg-blue-600 text-white py-3 px-4 rounded-lg font-semibold hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition"
      >
        Update Account
      </button>
      <a
        href="/account/"
        class="flex-1 bg-gray-200 text-gray-700 py-3 px-4 rounded-lg font-semibold hover:bg-gray-300 text-center transition"
      >
        Cancel
      </a>
    </div>
  </form>

  <%# Link para alterar senha %>
  <div class="mt-6 text-center">
    <p class="text-gray-600">
      Need to change your password?
      <a href="/account/update-password" class="text-blue-600 hover:underline font-medium">
        Change Password
      </a>
    </p>
  </div>
</div>

<%# Client-side validation %>
<script>
document.getElementById('updateAccountForm').addEventListener('submit', function(e) {
  const firstname = document.getElementById('account_firstname').value.trim();
  const lastname = document.getElementById('account_lastname').value.trim();
  const email = document.getElementById('account_email').value.trim();

  let errors = [];

  if (firstname.length < 1) {
    errors.push('First name is required.');
  }

  if (lastname.length < 1) {
    errors.push('Last name is required.');
  }

  // Email validation regex
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(email)) {
    errors.push('Please enter a valid email address.');
  }

  if (errors.length > 0) {
    e.preventDefault();
    alert('Please fix the following errors:\n\n' + errors.join('\n'));
  }
});
</script>
