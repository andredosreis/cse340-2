<%# Content Heading %>
  <% if (flash) { %>
    <div class="flash-message">
      <%= flash %>
    </div>
    <% } %>

      <div class="management-view max-w-4xl mx-auto p-6">
        <h1 class="text-3xl font-bold mb-8 text-gray-800 border-b pb-4">
          <%= title %>
        </h1>

        <div class="management-links flex flex-col gap-4">
          <a href="/inv/add-classification"
            class="management-link block w-full md:w-1/2 bg-white border border-gray-300 rounded-lg p-4 text-blue-600 font-semibold hover:bg-blue-50 hover:text-blue-800 hover:shadow-md transition duration-200 flex items-center">
            <span class="mr-2">➕</span> Add New Classification
          </a>
          <a href="/inv/add-inventory"
            class="management-link block w-full md:w-1/2 bg-white border border-gray-300 rounded-lg p-4 text-blue-600 font-semibold hover:bg-blue-50 hover:text-blue-800 hover:shadow-md transition duration-200 flex items-center">
            <span class="mr-2">🚗</span> Add New Vehicle
          </a>
        </div>

      </div>