<% if (title) { %>
  <h1 class="text-4xl font-bold text-red-600 mb-4"><%= title %></h1>
<% } else { %>
  <h1 class="text-4xl font-bold text-red-600 mb-4">Oops! Something went wrong</h1>
<% } %>

<div class="bg-white p-6 rounded-lg shadow-lg">
  <% if (message) { %>
    <p class="text-xl text-gray-700 mb-4"><%= message %></p>
  <% } %>

  <div class="mt-6">
    <a href="/" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
      Go Back Home
    </a>
  </div>
</div>