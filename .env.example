# ==============================================
# CSE 340 - DATABASE CONFIGURATION (EXAMPLE)
# ==============================================
# Este é um arquivo de EXEMPLO (template).
# Copie para .env e preencha com suas credenciais reais.
#
# NUNCA commite o arquivo .env no Git!
# O .gitignore já está configurado para ignorá-lo.

# ----------------------------------------------
# OPÇÃO 1: Render PostgreSQL (Cloud)
# ----------------------------------------------
# Obtenha essas credenciais em:
# https://dashboard.render.com > PostgreSQL > Connection String
#
# Exemplo de DATABASE_URL do Render:
# DATABASE_URL=postgresql://usuario:senha@host.render.com/database_name

# ----------------------------------------------
# OPÇÃO 2: PostgreSQL Local (seu computador)
# ----------------------------------------------
# Se instalou PostgreSQL localmente, use:
# DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/cse340

# ----------------------------------------------
# CONFIGURAÇÃO ATUAL
# ----------------------------------------------
# Cole sua connection string abaixo:
DATABASE_URL=

# Configurações opcionais (ajuste conforme necessário)
NODE_ENV=development
PORT=5500
SESSION_SECRET=your-session-secret-here

# ----------------------------------------------
# JWT (JSON Web Token) Configuration
# ----------------------------------------------
# Chave secreta para assinar tokens JWT
# Use uma string longa e aleatória para produção
ACCESS_TOKEN_SECRET=your-jwt-secret-key-here